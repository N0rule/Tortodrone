teract Node/Action (No Limit)\"}","config.argument.Limit":"string|1","config.argument.Sprite Offset - Z Axis":"float|0.7","handler-index":"0","kind":"Original","native-type":"com.threerings.tudey.data.actor.Actor","source-key":"1776","source-shape":"{\"arguments\":{\"value\":{\"class\":\"com.threerings.tudey.shape.config.ShapeConfig$Circle\",\"fields\":[{\"fieldType\":\"float\",\"name\":\"radius\",\"value\":{\"type\":\"float\",\"value\":0.49}}],\"type\":\"object\"}},\"name\":\"shape\"}"},"dynamic_misc_interact_node_base_1800_0":{"config":"Dynamic/Misc/Interact Node/Base","config.argument.Action Handler":"model|{\"arguments\":{\"Action\":{\"class\":\"com.threerings.projectx.dungeon.config.DungeonActionConfig$FireAction\",\"fields\":[{\"fieldType\":\"com.threerings.config.ConfigReference\",\"name\":\"fireAction\",\"value\":{\"type\":\"model\",\"value\":{\"arguments\":{},\"name\":\"Mission/Hall of Heroes/Piercing Def 5 Star\"}}}],\"type\":\"object\"},\"Description\":{\"type\":\"model\",\"value\":{\"arguments\":{},\"name\":\"Shop/Hall of Heroes/Mannequins/Piercing Def (shop)\"}},\"Interact Type\":{\"class\":\"com.threerings.projectx.config.ActionDesc$Interact\",\"fields\":[],\"type\":\"object\"}},\"name\":\"Dynamic Object/Interact Node/Action (No Limit)\"}","config.argument.Limit":"string|1","config.argument.Sprite Offset - Z Axis":"float|0.7","handler-index":"0","kind":"Original","native-type":"com.threerings.tudey.data.actor.Actor","source-key":"1800","source-shape":"{\"arguments\":{\"value\":{\"class\":\"com.threerings.tudey.shape.config.ShapeConfig$Circle\",\"fields\":[{\"fieldType\":\"float\",\"name\":\"radius\",\"value\":{\"type\":\"float\",\"value\":0.49}}],\"type\":\"object\"}},\"name\":\"shape\"}"},"dynamic_misc_interact_node_base_1808_0":{"config":"Dynamic/Misc/Interact Node/Base","config.argument.Action Handler":"model|{\"arguments\":{\"Action\":{\"class\":\"com.threerings.projectx.dungeon.config.DungeonActionConfig$FireAction\",\"fields\":[{\"fieldType\":\"com.threerings.config.ConfigReference\",\"name\":\"fireAction\",\"value\":{\"type\":\"model\",\"value\":{\"arguments\":{},\"name\":\"Mission/Hall of Heroes/Elemental Def 5 Star\"}}}],\"type\":\"object\"},\"Description\":{\"type\":\"model\",\"value\":{\"arguments\":{},\"name\":\"Shop/Hall of Heroes/Mannequins/Elemental Def (shop)\"}},\"Interact Type\":{\"class\":\"com.threerings.projectx.config.ActionDesc$Interact\",\"fields\":[],\"type\":\"object\"}},\"name\":\"Dynamic Object/Interact Node/Action (No Limit)\"}","config.argument.Limit":"string|1","config.argument.Sprite Offset - Z Axis":"float|0.7","handler-index":"0","kind":"Original","native-type":"com.threerings.tudey.data.actor.Actor","source-key":"1808","source-shape":"{\"arguments\":{\"value\":{\"class\":\"com.threerings.tudey.shape.config.ShapeConfig$Circle\",\"fields\":[{\"fieldType\":\"float\",\"name\":\"radius\",\"value\":{\"type\":\"float\",\"value\":0.49}}],\"type\":\"object\"}},\"name\":\"shape\"}"}},"mechanicFields":[],"mechanics":{},"npcs":{"mannequin0":{"nodes":{"part_1a":{"defaultText":"Hello {0}, I'm Remi, a knight who specializes in bombs and explosives.  The recipes I have for you are pretty straightforward- producing weapons and gear that focus on blowing up your enemies to smithereens! \n\nUsing bombs isn't a fire and forget kind of affair though.  Bombs require an understanding of timing, both before and after you drop one, in order to get the most bang for your buck.  The gear I specialize in will make you a knight that your squad sends in to take down many enemies at once.  Bombs are great for clearing out a mob of beasties in one swift KA-BOOM!","key":"m.hall_of_heroes_bomber_1a","properties":{},"responses":[{"defaultText":"Ok, let's see what you have to offer.  (Browse recipes)","key":"r.hall_of_heroes_bomber_1a","properties":{"station":"Character/NPC/Hall of Heroes/Mannequins/Bomber 5 Star/shop"}},{"defaultText":"End conversation","key":"r.hall_of_heroes_bomber_1b","properties":{}}]}},"properties":{"actor":"Character/NPC/Hall of Heroes/Mannequins/Bomber 5 Star","bundle":"mission","model":"{\"name\":\"character/npc/crew/halls_of_heroes/model_bomber_5.dat\",\"arguments\":{}}","name":"n.hoh_bomber"}},"mannequin10":{"nodes":{"part_1a":{"defaultText":"Hello {0}, I am Sylvin, a knight who utilizes gear that offers high shadow damage defense.  The recipes I have for you produce armor and shields that protect you from the shadow attacks of fiends and the undead. \n\nShadow defense can be harnessed from the shadows themselves.  The armor and shields I specialize in are derived from the very fiendish and undead creatures that seek to use the power of the shadows against you.  Plus, it looks incredibly scary and cool.","key":"m.hall_of_heroes_shadow_1a","properties":{},"responses":[{"defaultText":"Ok, let's see what you have to offer.  (Browse recipes)","key":"r.hall_of_heroes_shadow_1a","properties":{"station":"Character/NPC/Hall of Heroes/Mannequins/Shadow Def 5 Star/shop"}},{"defaultText":"End conversation","key":"r.hall_of_heroes_shadow_1b","properties":{}}]}},"properties":{"actor":"Character/NPC/Hall of Heroes/Mannequins/Shadow Def 5 Star","bundle":"mission","model":"{\"name\":\"character/npc/crew/halls_of_heroes/model_shadow_def_5.dat\",\"arguments\":{}}","name":"n.hoh_shadow"}},"mannequin13":{"nodes":{"part_1a":{"defaultText":"Hi there {0}, I'm Zebulon, a knight who utilizes specialty gear that is suited for specific scenarios.  The recipes I have for you produce weapons that target specific monster families and gear that has mixed defense types. \n\nSometimes what you really need is a sword that smites the undead or armor that raises your slime smashing proficiency.  The gear I specialize in is often built for a specific task, but is also great to mix and match with other sets.  Experiment!","key":"m.hall_of_heroes_specialist_1a","properties":{},"responses":[{"defaultText":"Ok, let's see what you have to offer.  (Browse recipes)","key":"r.hall_of_heroes_specialist_1a","properties":{"station":"Character/NPC/Hall of Heroes/Mannequins/Specialist 5 Star/shop"}},{"defaultText":"End conversation","key":"r.hall_of_heroes_specialist_1b","properties":{}}]}},"properties":{"actor":"Character/NPC/Hall of Heroes/Mannequins/Specialist 5 Star","bundle":"mission","model":"{\"name\":\"character/npc/crew/halls_of_heroes/model_specialist_5.dat\",\"arguments\":{}}","name":"n.hoh_specialist"}},"mannequin14":{"nodes":{"part_1a":{"defaultText":"Hi there {0}, I'm Walkon, a knight who utilizes gear that offers high piercing damage defense.  The recipes I have for you produce armor and shields that protect you from the piercing attacks of slimes and beasts. \n\nOne of the best parts about choosing piercing defense is that the armor is often made of soft, squishy jelly materials.  You could just about fall asleep in it!","key":"m.hall_of_heroes_piercing_1a","properties":{},"responses":[{"defaultText":"Ok, let's see what you have to offer.  (Browse recipes)","key":"r.hall_of_heroes_piercing_1a","properties":{"station":"Character/NPC/Hall of Heroes/Mannequins/Piercing Def 5 Star/shop"}},{"defaultText":"End conversation","key":"r.hall_of_heroes_piercing_1b","properties":{}}]}},"properties":{"actor":"Character/NPC/Hall of Heroes/Mannequins/Piercing Def 5 Star","bundle":"mission","model":"{\"name\":\"character/npc/crew/halls_of_heroes/model_pierce_def_5.dat\",\"arguments\":{}}","name":"n.hoh_piercing"}},"mannequin17":{"nodes":{"part_1a":{"defaultText":"Greetings {0}, I'm Archilus, a knight who utilizes gear that offers high elemental damage defense.  The recipes I have for you produce armor and shields that protect you from the elemental attacks of constructs and gremlins. \n\nElemental resistant armor and shields are adapted from Owlite technology.  Though the Owlites themselves no longer exist, their amazing elemental mastery lives on in this gear.","key":"m.hall_of_heroes_elemental_1a","properties":{},"responses":[{"defaultText":"Ok, let's see what you have to offer.  (Browse recipes)","key":"r.hall_of_heroes_elemental_1a","properties":{"station":"Character/NPC/Hall of Heroes/Mannequins/Elemental Def 5 Star/shop"}},{"defaultText":"End conversation","key":"r.hall_of_heroes_elemental_1b","properties":{}}]}},"properties":{"actor":"Character/NPC/Hall of Heroes/Mannequins/Elemental Def 5 Star","bundle":"mission","model":"{\"name\":\"character/npc/crew/halls_of_heroes/model_elemental_def_5.dat\",\"arguments\":{}}","name":"n.hoh_elemental"}},"mannequin3":{"nodes":{"part_1a":{"defaultText":"Greetings {0}, I'm Echo, a knight who utilizes gear fit for a squad striker.  The recipes I have for you produce weapons and gear that focus on rapid, close-quarters combat. \n\nThe arsenal of a striker focuses on speed.  You want to get in close with your enemy, hit them hard and get out.  The gear I specialize in will make you a knight that leaps into battle ahead of your squad, striking first before they can even fire off a shot.","key":"m.hall_of_heroes_striker_1a","properties":{},"responses":[{"defaultText":"Ok, let's see what you have to offer.  (Browse recipes)","key":"r.hall_of_heroes_striker_1a","properties":{"station":"Character/NPC/Hall of Heroes/Mannequins/Striker 5 Star/shop"}},{"defaultText":"End conversation","key":"r.hall_of_heroes_striker_1b","properties":{}}]}},"properties":{"actor":"Character/NPC/Hall of Heroes/Mannequins/Striker 5 Star","bundle":"mission","model":"{\"name\":\"character/npc/crew/halls_of_heroes/model_striker_5.dat\",\"arguments\":{}}","name":"n.hoh_striker"}},"mannequin4":{"nodes":{"part_1a":{"defaultText":"Howdy {0}, the name's Daxen. I'm a knight who specializes in gunslinging.  The recipes I have for you produce weapons and gear that focus on ranged combat... you know, shootin' stuff. \n\nHandguns allow you to hit your enemies from a safe distance, but don't offer you many options once they close in on ya.  You've got to think and shoot fast to be a good gunslinger.  The gear I specialize in will make you a dead shot, not a dead knight.","key":"m.hall_of_heroes_gunner_1a","properties":{},"responses":[{"defaultText":"Ok, let's see what you have to offer.  (Browse recipes)","key":"r.hall_of_heroes_gunner_1a","properties":{"station":"Character/NPC/Hall of Heroes/Mannequins/Gunner 5 Star/shop"}},{"defaultText":"End conversation","key":"r.hall_of_heroes_gunner_1b","properties":{}}]}},"properties":{"actor":"Character/NPC/Hall of Heroes/Mannequins/Gunner 5 Star","bundle":"mission","model":"{\"name\":\"character/npc/crew/halls_of_heroes/model_gunner_5.dat\",\"arguments\":{}}","name":"n.hoh_gunner"}},"mannequin7":{"nodes":{"part_1a":{"defaultText":"Hello {0}, I'm Izola, a knight who utilizes gear fit for a squad guardian.  The recipes I have for you produce highly defensive armor and hard-hitting weapons. \n\nHeavy weapons require precise timing to use effectively and the gear tends to slow you down some.  But what you sacrifice in usability is returned in sheer power.  The gear I specialize in will make you a knight that your squad can depend upon to stay alive and face even the fiercest of monsters.","key":"m.hall_of_heroes_heavy_1a","properties":{},"responses":[{"defaultText":"Ok, let's see what you have to offer.  (Browse recipes)","key":"r.hall_of_heroes_heavy_1a","properties":{"station":"Character/NPC/Hall of Heroes/Mannequins/Heavy 5 Star/shop"}},{"defaultText":"End conversation","key":"r.hall_of_heroes_heavy_1b","properties":{}}]}},"properties":{"actor":"Character/NPC/Hall of Heroes/Mannequins/Heavy 5 Star","bundle":"mission","model":"{\"name\":\"character/npc/crew/halls_of_heroes/model_heavy_5.dat\",\"arguments\":{}}","name":"n.hoh_heavy"}},"mannequin9":{"nodes":{"part_1a":{"defaultText":"Well met, {0}.  I'm Jorin, a knight who has mastered the standard issue Spiral Knight gear.  The recipes I have for you produce very reliable weapons and gear. \n\nJust because your weapons don't output fancy special damage types or your armor defends from status conditions doesn't mean you can't shake it in the Clockworks.  The gear I specialize in is good for just about any situation.  It will keep you alive and packs a punch on almost any monster that comes your way.","key":"m.hall_of_heroes_cobalt_1a","properties":{},"responses":[{"defaultText":"Ok, let's see what you have to offer.  (Browse recipes)","key":"r.hall_of_heroes_cobalt_1a","properties":{"station":"Character/NPC/Hall of Heroes/Mannequins/Cobalt 5 Star/shop"}},{"defaultText":"End conversation","key":"r.hall_of_heroes_cobalt_1b","properties":{}}]}},"properties":{"actor":"Character/NPC/Hall of Heroes/Mannequins/Cobalt 5 Star","bundle":"mission","model":"{\"name\":\"character/npc/crew/halls_of_heroes/model_cobalt_5.dat\",\"arguments\":{}}","name":"n.hoh_cobalt"}}},"portals":{"2812":{"shape":"polygon","vertices":"-2.5,-12.5;3.5,-12.5;3.5,-14.5;-2.5,-14.5"}},"shared":["combat"]}