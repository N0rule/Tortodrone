_gate_3.id":"2333","destination.from_gate_3.rotation":"-1.5707964","destination.from_gate_3.x":"24.5","destination.from_gate_3.y":"14.5","destination.from_town_square_north.id":"462","destination.from_town_square_north.rotation":"1.5707977","destination.from_town_square_north.x":"3.5","destination.from_town_square_north.y":"-4","destination.move_feron.id":"1983","destination.move_feron.rotation":"1.9198623","destination.move_feron.x":"-5.2299585","destination.move_feron.y":"0.45708352","destination.move_wegner.id":"1982","destination.move_wegner.rotation":"1.3089968","destination.move_wegner.x":"14.152535","destination.move_wegner.y":"1.3145498"},"npcs":{"town7":{"nodes":{"part 1a":{"defaultText":"Hello. I'm Wegner, Chief Geo Knight of the Skylark and head of geological studies within the Clockworks.","key":"m.arc_mintut_1","properties":{},"responses":[{"defaultText":"I'm here to learn about the minerals found within the Clockworks.","key":"r.arc_mintut_1","properties":{}}]},"part 2a":{"defaultText":"During your travels in the Clockworks you will encounter five special minerals: crimsonite, moonstone, valestone, luminite and dark matter.","key":"m.arc_mintut_2","properties":{},"responses":[{"defaultText":"Continue","key":"r.arc_mintut_2","properties":{}}]},"part 3a":{"defaultText":"You will find ore deposits in all levels of the Clockworks, and you must attack them in order to break them down into a size you can carry. You can only pick up one at a time, but you can swap them by picking up another. Look for the biggest, shiniest one you can find. They are the most valuable.","key":"m.arc_mintut_3","properties":{},"responses":[{"defaultText":"Continue","key":"r.arc_mintut_3","properties":{}}]},"part 4a":{"defaultText":"Once you safely reach the elevator, the mineral you are carrying gets deposited in your arsenal for use later. Everyone in your party gets everyone else's minerals, so no need to fight over who gets the best one!","key":"m.arc_mintut_4","properties":{},"responses":[{"defaultText":"Continue","key":"r.arc_mintut_4","properties":{}}]},"part 5a":{"defaultText":"Minerals are used to create sprite food in the Laboratory. Sprite food is very important to the development of your sprite, so grab those minerals when you see them!","key":"m.arc_mintut_5","properties":{},"responses":[{"defaultText":"Continue","key":"r.arc_mintut_5","properties":{}}]},"part 6a":{"defaultText":"Our geological research is ongoing, so there may yet be other fascinating uses for these strange and powerful minerals.","key":"m.arc_mintut_6","properties":{},"responses":[{"defaultText":"Sounds great! Thanks for the info!","key":"r.arc_mintut_6","properties":{}}]}},"properties":{"actor":"scene.3.1717.7","bundle":"npc","model":"{\"name\":\"character/npc/crew/model_geo.dat\",\"arguments\":{}}","name":"~"}}},"portalAliases":{"to_bazaar_1":"2980","to_bazaar_2":"934","to_garrison_1":"2194","to_haven_1":"933"},"portals":{"2194":{"shape":"polygon","vertices":"34.0,-7.0;40.0,-7.0;40.0,-10.0;34.0,-10.0"},"2980":{"shape":"polygon","vertices":"-45.0,3.0;-41.0,3.0;-41.0,-2.0;-45.0,-2.0"},"933":{"shape":"polygon","vertices":"1.0,-7.0;6.0,-7.0;6.0,-10.0;1.0,-10.0"},"934":{"shape":"polygon","vertices":"-32.0,-7.0;-26.0,-7.0;-26.0,-10.0;-32.0,-10.0"}},"shared":["combat"]}
