[{\"fieldType\":\"float\",\"name\":\"width\",\"value\":{\"type\":\"float\",\"value\":1.0}},{\"fieldType\":\"float\",\"name\":\"height\",\"value\":{\"type\":\"float\",\"value\":1.0}}],\"type\":\"object\"}},\"name\":\"shape\"}","switch-mode":"damage-timed","switch-damage-mask":"2","switch-delay":"8000","state.1.effect":"Objects/Monster Objects/Beast Bell/Ring bell, beast stun","state.1.status":"{\"name\":\"Stun 2\",\"arguments\":{\"Chance\":{\"type\":\"float\",\"value\":1.0},\"Power\":50,\"Status Chance\":{\"type\":\"enum\",\"class\":\"com.threerings.projectx.dungeon.data.StatusCodes$StatusChance\",\"name\":\"CUSTOM\",\"ordinal\":0},\"Status Power\":{\"type\":\"enum\",\"class\":\"com.threerings.projectx.dungeon.data.StatusCodes$StatusPower\",\"name\":\"DEADLY\",\"ordinal\":4}}}","state.1.status-tag":"fam_beast","state.1.status-radius":"4.5"},"shop_haven_alchemy_1338_0":{"config":"Shop/Haven/Alchemy","handler-index":"0","kind":"Agent","native-type":"com.threerings.tudey.data.actor.Agent","rotation":"-1.5707964","source-key":"1338","source-shape":"{\"arguments\":{\"value\":{\"class\":\"com.threerings.tudey.shape.config.ShapeConfig$Circle\",\"fields\":[{\"fieldType\":\"float\",\"name\":\"radius\",\"value\":{\"type\":\"float\",\"value\":1.0}}],\"type\":\"object\"}},\"name\":\"shape\"}"},"shop_haven_alchemy_battle_sprites_207_0":{"config":"Shop/Haven/Alchemy, Battle Sprites","handler-index":"0","kind":"Agent","native-type":"com.threerings.tudey.data.actor.Agent","rotation":"-1.5707964","source-key":"207","source-shape":"{\"arguments\":{\"value\":{\"class\":\"com.threerings.tudey.shape.config.ShapeConfig$Circle\",\"fields\":[{\"fieldType\":\"float\",\"name\":\"radius\",\"value\":{\"type\":\"float\",\"value\":1.0}}],\"type\":\"object\"}},\"name\":\"shape\"}"},"shop_haven_harness_installer_1820_0":{"config":"Shop/Haven/Harness Installer","handler-index":"0","kind":"Stranger","native-type":"com.threerings.projectx.data.actor.Stranger","rotation":"-0.78539824","source-key":"1820","source-shape":"{\"arguments\":{\"value\":{\"class\":\"com.threerings.tudey.shape.config.ShapeConfig$Circle\",\"fields\":[{\"fieldType\":\"float\",\"name\":\"radius\",\"value\":{\"type\":\"float\",\"value\":0.6}}],\"type\":\"object\"}},\"name\":\"shape\"}"}},"entranceAngles":{"level_start":{"displayDegrees":-180.0,"radians":"-3.141592"}},"mechanicFields":[],"mechanics":{},"npcs":{"scene.30893.placed.113":{"nodes":{"part 1a":{"defaultText":"We managed to pull the secondary generator from the Skylark mostly intact. Unfortunately it's barely powerful enough to keep this lab running, let alone power our ship.  We'll need to find another power source if we ever hope to return home.","key":"m.lab_knight3_1a","properties":{},"responses":[{"defaultText":"End conversation","key":"r.lab_knight1_1a","properties":{}}]}},"properties":{"actor":"scene.30893.placed.113","bundle":"npc","model":"{\"name\":\"character/npc/crew/biotech/model_plume.dat\",\"arguments\":{\"Animation\":{\"type\":\"model\",\"value\":{\"name\":\"character/pc/use_inventory_loop.dat\",\"arguments\":{}}},\"Weapon Equip\":{\"type\":\"null\"}}}","name":"n.biotech"}},"scene.30893.placed.1760":{"nodes":{"part 1a":{"defaultText":"Gremlins of Emberlight thank you for stopping this threat.","key":"m.emberlight_visitor_1a","properties":{},"responses":[{"defaultText":"Continue","key":"r.emberlight_visitor_1a","properties":{}}]},"part 2a":{"defaultText":"But I come to warn you!  Crimson Order not stop with Roarmulus Project.  Crimson Order desperate to destroy all enemies. Tall ones, little ones, and outcasts.  All enemies to Crimson Order!","key":"m.emberlight_visitor_2a","properties":{},"responses":[{"defaultText":"Thanks for the warning, Pakrat.","key":"r.emberlight_visitor_2a","properties":{}}]},"part 3a":{"defaultText":"Help you with something?","key":"m.emberlight_visitor_3a","properties":{},"responses":[{"defaultText":"Tell me about Emberlight.","key":"r.emberlight_visitor_3a","properties":{}},{"defaultText":"Why is King Tinkinzar trying to destroy Haven?","key":"r.emberlight_visitor_3b","properties":{}},{"defaultText":"I have enough info, thanks. (End conversation)","key":"r.emberlight_visitor_3c","properties":{}}]},"part 4a":{"defaultText":"Emberlight founded by gremlin outcasts from Great Colony. Gremlins of Emberlight not obey the Iron Law, so flee or die. We start over with Emberlight. New colony home to few of us: most ex-schemers, some merchants, some fighters, all traitors in eyes of Great Colony gremlins.","key":"m.emberlight_visitor_4a","properties":{},"responses":[{"defaultText":"One more question, Pakrat.","key":"r.emberlight_visitor_4a","properties":{}},{"defaultText":"End conversation","key":"r.lab_progress_end","properties":{}}]},"part 4b":{"defaultText":"None know for sure. Tinkinzar not seen for many many years. Crimson Order carries out Tinkinzar's plans for Cradle. Emberlight was blight on master plan because built by outcasts. Haven probably the same, founded by non-gremlins. Not part of plan!","key":"m.emberlight_visitor_4b","properties":{},"responses":[{"defaultText":"One more question, Pakrat.","key":"r.emberlight_visitor_4a","properties":{}},{"defaultText":"End conversation","key":"r.lab_progress_end","properties":{}}]}},"properties":{"actor":"scene.30893.placed.1760","bundle":"npc","model":"{\"name\":\"character/npc/monster/gremlin/null/model.dat\",\"arguments\":{\"Variant\":\"Ember\",\"Weapon\":{\"type\":\"null\"}}}","name":"n.emberlight_visitor"}},"scene.30893.placed.1793":{"nodes":{"part 1a":{"defaultText":"We've recovered what little remains from Owlite Keep concerning the Kingdom of Almire. Combined with the snippets we've gotten from the nature sprites within Firestorm Citadel itself, we are starting to get a clearer picture of Almire's history.","key":"m.almire_historian_1a","properties":{},"responses":[{"defaultText":"What have you learned about Almire?","key":"r.almire_historian_1a","properties":{}}]},"part 2a":{"defaultText":"From the tomes we have recovered, we've learned that Firestorm Citadel was once part of a much larger kingdom known as Almire thousands of years ago. Although it was bordered by other aggressive nations, Almire was renowned for the martial prowess of its many legions. These legions kept the kingdom safe for many years. Alas, they weren't enough.","key":"m.almire_historian_2a","properties":{},"responses":[{"defaultText":"What happened to the rest of the kingdom?","key":"r.almire_historian_2a","properties":{}}]},"part 3a":{"defaultText":"Well, we now know there were massive citadels housing Almire's armed forces and great estates for its noble houses. It must have been quite a sight to see. We assume the rest of the kingdom is still a smoldering ruin somewhere. It is possible that some of it might have survived...though given the anecdotal evidence we think it is unlikely at best.","key":"m.almire_historian_3a","properties":{},"responses":[{"defaultText":"End conversation","key":"r.lab_progress_end","properties":{}}]}},"properties":{"actor":"scene.30893.placed.1793","bundle":"npc","model":"{\"name\":\"character/npc/crew/biotech/model_hood.dat\",\"arguments\":{\"Animation\":{\"type\":\"model\",\"value\":{\"name\":\"character/pc/use_inventory_loop.dat\",\"arguments\":{}}},\"Weapon Equip\":{\"type\":\"null\"}}}","name":"n.biotech"}},"scene.30893.placed.1809":{"nodes":{"part 1a":{"defaultText":"Another strange device! This one was clearly not made by the Almirians any more than the previous device was made by jellies. One thing we've noticed however: this device is still active. On top of that, the energy signature is similar to the readings we took off the Artifact before it was stolen. This requires some further research I think.","key":"m.lab_progress_9","properties":{},"responses":[{"defaultText":"End conversation","key":"r.lab_progress_end","properties":{}}]}},"properties":{"actor":"scene.30893.placed.1809","bundle":"npc","model":"{\"name\":\"character/npc/crew/biotech/model_hood.dat\",\"arguments\":{\"Animation\":{\"type\":\"model\",\"value\":{\"name\":\"character/pc/idle.dat\",\"arguments\":{}}},\"Weapon Equip\":{\"type\":\"null\"}}}","name":"n.biotech"}},"scene.30893.placed.214":{"nodes":{"part 1a":{"defaultText":"We salvaged what we could from the Skylark and cobbled together the rest with help from the Strangers.","key":"m.lab_knight1_1a","properties":{},"responses":[{"defaultText":"End conversation","key":"r.lab_knight1_1a","properties":{}}]}},"properties":{"actor":"scene.30893.placed.214","bundle":"npc","model":"{\"name\":\"character/npc/crew/biotech/model_hood.dat\",\"arguments\":{\"Animation\":{\"type\":\"model\",\"value\":{\"name\":\"character/pc/sitting/animation_sit_chair_loop.dat\",\"arguments\":{}}},\"Weapon Equip\":{\"type\":\"null\"}}}","name":"n.biotech"}},"scene.30893.placed.706":{"nodes":{"part 1a":{"defaultText":"Recon teams have recovered some strange and remarkable things from within the Clockworks.","key":"m.lab_knight4_1a","properties":{},"responses":[{"defaultText":"End conversation","key":"r.lab_knight1_1a","properties":{}}]}},"properties":{"actor":"scene.30893.placed.706","bundle":"npc","model":"{\"name\":\"character/npc/crew/biotech/model_hood.dat\",\"arguments\":{\"Animation\":{\"type\":\"model\",\"value\":{\"name\":\"character/pc/idle.dat\",\"arguments\":{}}},\"Weapon Equip\":{\"type\":\"null\"}}}","name":"n.biotech"}},"scene.30893.placed.707":{"nodes":{"part 1a":{"defaultText":"{0}, have you seen these minerals in your travels yet?  They're fascinating! You should ask Chief Geo Knight Wegner about them.  I hear he's the expert on minerals!","key":"m.lab_knight5_1a","properties":{},"responses":[{"defaultText":"End conversation","key":"r.lab_knight1_1a","properties":{}}]}},"properties":{"actor":"scene.30893.placed.707","bundle":"npc","model":"{\"name\":\"character/npc/crew/model.dat\",\"arguments\":{\"Animation\":{\"type\":\"model\",\"value\":{\"name\":\"character/pc/idle.dat\",\"arguments\":{}}},\"Armor\":\"Petite\",\"Gear\":\"None\",\"Height\":\"+2\",\"Helmet\":\"Hood\",\"Pack\":\"None\",\"Weapon Equip\":{\"type\":\"null\"}}}","name":"n.geoknight"}}},"portalAliases":{"to_garrison_1":"945"},"portals":{"945":{"shape":"polygon","vertices":"-3.5,-7.5;2.5,-7.5;2.5,-9.5;-3.5,-9.5"}},"shared":["statuses","combat"]}
